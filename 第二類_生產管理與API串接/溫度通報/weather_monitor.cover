    1:     payload = {
    1:         "@type": "MessageCard",
    1:         "@context": "http://schema.org/extensions",
    1:         "themeColor": "D9534F" if "警報" in subject else "5CB85C",
    1:         "summary": subject,
    1:         "title": subject,
    1:         "text": message.replace("\n", "\n\n")
           }
           
    1:     data = json.dumps(payload).encode("utf-8")
    2:     req = urllib.request.Request(
    1:         webhook_url, 
    1:         data=data, 
    1:         headers={"Content-Type": "application/json"}, 
    1:         method="POST"
           )
           
    1:     try:
    2:         with urllib.request.urlopen(req, timeout=10) as response:
    1:             status_code = response.getcode()
    1:             if status_code in [200, 202]:
    1:                 print("Teams 訊息推播成功！")
    1:                 return True
                   else:
                       print(f"【Teams API 錯誤】狀態碼 {status_code}", file=sys.stderr)
                       return False
