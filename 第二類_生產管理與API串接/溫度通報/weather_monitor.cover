    1:             sheets = meta.get("sheets", [])
    1:             if sheets:
    1:                 return sheets[0].get("properties", {}).get("title")
           except Exception as e:
               print(f"【警告】動態取得分頁名稱失敗: {e}", file=sys.stderr)
           return "工作表1"
       
