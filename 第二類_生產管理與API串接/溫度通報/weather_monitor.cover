    1: def send_email_notifications(email_config, subject, body, recipients):
           """透過 SMTP 一次發送電子郵件通知給多個收件人"""
    1:     smtp_server = email_config.get("smtp_server")
    1:     smtp_port = email_config.get("smtp_port", 587)
    1:     user = email_config.get("smtp_user")
    1:     password = email_config.get("smtp_password")
    1:     from_email = email_config.get("from_email", user)
           
    1:     if not smtp_server or "YOUR_EMAIL" in user:
               print("【警告】未設定有效的 SMTP 帳號資訊，跳過郵件發送。")
               return False
               
    1:     if not recipients:
               print("【警告】郵件收件者清單為空，跳過發送. ")
               return False
               
    1:     msg = MIMEText(body, "plain", "utf-8")
    1:     msg["Subject"] = Header(subject, "utf-8")
    1:     msg["From"] = from_email
    1:     msg["To"] = ", ".join(recipients)
           
    1:     try:
    1:         if smtp_port == 465:
                   server = smtplib.SMTP_SSL(smtp_server, smtp_port, timeout=10)
               else:
    1:             server = smtplib.SMTP(smtp_server, smtp_port, timeout=10)
    1:             server.ehlo()
    1:             server.starttls()
    1:             server.ehlo()
                   
    1:         if user and password:
    1:             server.login(user, password)
                   
    1:         server.sendmail(from_email, recipients, msg.as_string())
    1:         server.close()
    1:         print(f"電子郵件發送成功！(收件者數量: {len(recipients)} 人)")
    1:         return True
           except Exception as e:
               print(f"【錯誤】發送電子郵件時發生異常: {e}", file=sys.stderr)
               return False
       
    1: def send_teams_notifications(teams_config, subject, message):
