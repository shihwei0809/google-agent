    1: def add_realtime_log_to_firebase(current_temp, obs_time):
           """將即時 10 分鐘觀測數據寫入 Firestore realtime_logs，並自動清理 24 小時前舊資料"""
    1:     token, project_id = _get_firebase_token()
    1:     if not token:
               return
    1:     url = f"https://firestore.googleapis.com/v1/projects/{project_id}/databases/(default)/documents/realtime_logs"
    1:     now_ms = int(time.time() * 1000)
           
           # 1. 寫入 10 分鐘即時記錄
    1:     doc_id = "rt_" + str(now_ms)
    1:     doc_url = f"{url}/{doc_id}"
           
    1:     def _fs(v):
    3:         if isinstance(v, float): return {"doubleValue": v}
    2:         return {"stringValue": str(v)}
               
    1:     fields = {
    1:         "temp": _fs(current_temp),
    1:         "time": _fs(datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=8))).strftime('%Y-%m-%d %H:%M:%S')),
    1:         "obs_time": _fs(obs_time),
    1:         "timestamp": {"integerValue": str(now_ms)}
           }
           
    1:     payload = json.dumps({"fields": fields}).encode("utf-8")
    2:     req = urllib.request.Request(
    1:         doc_url, data=payload, method="PATCH",
    2:         headers={"Authorization": f"Bearer {token}",
    1:                  "Content-Type": "application/json"}
           )
    1:     try:
    2:         with urllib.request.urlopen(req, timeout=10, context=_fb_ssl_ctx):
    1:             pass
    1:         print("【Firebase 即時紀錄】已寫入 realtime_logs")
           except Exception as e:
               print(f"【Firebase 即時紀錄】寫入失敗: {e}", file=sys.stderr)
               
           # 2. 自動清理 24 小時前的舊資料
    1:     try:
    1:         cutoff_ms = now_ms - 24 * 60 * 60 * 1000
    1:         query_url = f"https://firestore.googleapis.com/v1/projects/{project_id}/databases/(default)/documents:runQuery"
    1:         query_payload = {
    2:             "structuredQuery": {
    1:                 "from": [{"collectionId": "realtime_logs"}],
    2:                 "where": {
    2:                     "fieldFilter": {
    1:                         "field": {"fieldPath": "timestamp"},
    1:                         "op": "LESS_THAN",
    1:                         "value": {"integerValue": str(cutoff_ms)}
                           }
                       }
                   }
               }
    2:         req_query = urllib.request.Request(
    1:             query_url, data=json.dumps(query_payload).encode("utf-8"), method="POST",
    2:             headers={"Authorization": f"Bearer {token}",
    1:                      "Content-Type": "application/json"}
               )
    2:         with urllib.request.urlopen(req_query, timeout=10, context=_fb_ssl_ctx) as resp:
    1:             results = json.loads(resp.read().decode("utf-8"))
    2:             for res in results:
    1:                 doc = res.get("document")
    1:                 if doc:
                           doc_name = doc.get("name")
                           del_url = f"https://firestore.googleapis.com/v1/{doc_name}"
                           req_del = urllib.request.Request(
