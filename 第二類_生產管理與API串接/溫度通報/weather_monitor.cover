    1: def check_weather(config):
           """透過 CWA Open Data API 抓取即時觀測的環境溫度"""
    1:     api_key    = config.get("cwa_api_key", "")
    1:     station_id = config.get("cwa_station_id", "C2G870") # 預設改為伸港站
       
    1:     if not api_key:
               raise ValueError("請在 config.json 中設定 cwa_api_key。")
       
           # 改為 O-A0003-001 (自動氣象站)
    1:     url = (
    2:         f"https://opendata.cwa.gov.tw/api/v1/rest/datastore/O-A0003-001"
    1:         f"?Authorization={api_key}&StationId={station_id}"
           )
    1:     print(f"正在透過 CWA Open Data API 抓取觀測資料... (站點: {station_id})")
    1:     content = fetch_url(url)
    1:     data = json.loads(content)
       
    1:     stations = data.get("records", {}).get("Station", [])
    1:     if not stations:
               raise ValueError(f"CWA API 回傳空資料，StationId={station_id}")
       
    1:     s        = stations[0]
    1:     we       = s.get("WeatherElement", {})
    1:     raw_obs_time = s.get("ObsTime", {}).get("DateTime", "")
    1:     obs_time = raw_obs_time.replace("T", " ")[:19] if raw_obs_time else ""
       
    1:     temp = float(we.get("AirTemperature", -99))
       
    1:     if temp == -99:
               raise ValueError(f"站點 {station_id} 觀測環境溫度異常（-99），無法讀取。")
       
    1:     print(f"觀測時間: {obs_time}, 環境溫度: {temp}°C")
    1:     return temp, obs_time
       
    1: def send_line_notifications(line_config, message, recipients):
           """發送 LINE 訊息通知（支援 Multicast API 一次推播多人）"""
    1:     token = line_config.get("channel_access_token")
    1:     if not token or "YOUR_LINE" in token:
               print("【警告】未設定有效的 LINE Token，跳過 LINE 發送。")
               return False
               
    1:     if not recipients:
               print("【警告】LINE 收件者清單為空，跳過發送。")
               return False
               
           # 分離 User ID (U/u 開頭) 與 Group/Room ID (C/c 或 R/r 開頭)
    3:     user_ids = [r for r in recipients if r.upper().startswith("U")]
    3:     group_ids = [r for r in recipients if r.upper().startswith("C") or r.upper().startswith("R")]
           
    1:     success = False
           
           # 1. 對個人 ID 使用 Multicast API (支援一次最多 500 位個人接收者)
    1:     if user_ids:
               # 將收件者切分為每 500 人一組
    3:         for chunk in [user_ids[i:i + 500] for i in range(0, len(user_ids), 500)]:
    1:             url = "https://api.line.me/v2/bot/message/multicast"
    1:             headers = {
    1:                 "Content-Type": "application/json",
    1:                 "Authorization": f"Bearer {token}"
                   }
    1:             payload = {
    1:                 "to": chunk,
    2:                 "messages": [
    1:                     {
    1:                         "type": "text",
    1:                         "text": message
                           }
                       ]
                   }
                   
    1:             data = json.dumps(payload).encode("utf-8")
    1:             req = urllib.request.Request(url, data=data, headers=headers, method="POST")
    1:             try:
    2:                 with urllib.request.urlopen(req, timeout=10) as response:
    1:                     print(f"LINE 訊息 Multicast 推播成功！(收件者數量: {len(chunk)} 人)")
    1:                     success = True
                   except urllib.error.HTTPError as e:
                       err_body = e.read().decode("utf-8")
                       print(f"【LINE Multicast API 錯誤】狀態碼 {e.code}: {err_body}", file=sys.stderr)
                   except Exception as e:
