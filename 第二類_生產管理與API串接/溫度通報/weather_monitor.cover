    1: def get_realtime_backup_paths():
           """取得 24 小時趨勢備份的本機/雲端硬碟儲存路徑，支援自動建立資料夾，返回季度 CSV 與 XLSX 及每日 Sheet 名"""
    1:     tz_taiwan = datetime.timezone(datetime.timedelta(hours=8))
    1:     now = datetime.datetime.now(tz_taiwan)
    1:     year_str = now.strftime('%Y')
    1:     quarter = (now.month - 1) // 3 + 1
    1:     sheet_name = now.strftime('%m月%d日') # 例如 "06月30日"
           
    1:     csv_file = f"{year_str}-Q{quarter}_24小時趨勢備份.csv"
    1:     xlsx_file = f"{year_str}-Q{quarter}_24小時趨勢備份.xlsx"
           
           # 優先嘗試寫入 Google Drive 虛擬硬碟 G:\
    1:     g_drive_dir = r"G:\我的雲端硬碟\GOOGLE ANGET\溫度通報\24 小時趨勢備份"
    1:     try:
    1:         os.makedirs(g_drive_dir, exist_ok=True)
    1:         return os.path.join(g_drive_dir, csv_file), os.path.join(g_drive_dir, xlsx_file), sheet_name
           except Exception:
               # 若 G 槽未掛載或無寫入權限，回退到本地目錄下
               local_dir = os.path.join(SCRIPT_DIR, "24 小時趨勢備份")
               os.makedirs(local_dir, exist_ok=True)
               return os.path.join(local_dir, csv_file), os.path.join(local_dir, xlsx_file), sheet_name
       
