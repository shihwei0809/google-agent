                           bytesmsg, policy=msg.policy.clone(utf8=True))
                       mail_options = (*mail_options, 'SMTPUTF8', 'BODY=8BITMIME')
                   else:
                       g = email.generator.BytesGenerator(bytesmsg)
                   g.flatten(msg_copy, linesep='\r\n')
