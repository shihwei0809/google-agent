    1: MISC_LEN = 7
       
       
       # Helpers
    1: def header_length(bytearray):
           """Return the length of s when it is encoded with base64."""
   38:     groups_of_3, leftover = divmod(len(bytearray), 3)
           # 4 bytes out for each 3 bytes (or nonzero fraction thereof) in.
   38:     n = groups_of_3 * 4
   38:     if leftover:
   17:         n += 4
   38:     return n
       
       
    1: def header_encode(header_bytes, charset='iso-8859-1'):
           """Encode a single header line with Base64 encoding in a given charset.
       
           charset names the character set to use to encode the header.  It defaults
           to iso-8859-1.  Base64 encoding is defined in RFC 2045.
           """
    1:     if not header_bytes:
               return ""
    1:     if isinstance(header_bytes, str):
               header_bytes = header_bytes.encode(charset)
    1:     encoded = b64encode(header_bytes).decode("ascii")
    1:     return '=?%s?b?%s?=' % (charset, encoded)
       
       
    1: def body_encode(s, maxlinelen=76, eol=NL):
           r"""Encode a string with base64.
       
           Each line will be wrapped at, at most, maxlinelen characters (defaults to
           76 characters).
       
