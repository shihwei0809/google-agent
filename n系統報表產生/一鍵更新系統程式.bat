@echo off
cd /d "%~dp0"

:: 檢查上一層是否有 Git 版本庫 (若無，代表在 NAS 或一般目錄)
if exist "%~dp0..\.git" goto GIT_UPDATE

echo ==================================================
echo 【提醒】此「一鍵更新系統程式」不適合在 NAS 上執行！
echo 請在本機執行完後，再自行將最新檔案更新至 NAS。
echo ==================================================
echo.
echo 正在直接為您啟動主程式...
ping 127.0.0.1 -n 3 >nul
goto START_APP

:GIT_UPDATE
echo ==================================================
echo 正在從雲端更新系統程式...
echo ==================================================
cd ..
git --version >nul 2>&1
if errorlevel 1 goto START_APP

git pull
echo.
echo ==================================================
echo 更新完成！正在自動為您開啟系統...
echo ==================================================
ping 127.0.0.1 -n 2 >nul

:START_APP
cd /d "%~dp0"
start 啟動本機視窗版.bat
exit