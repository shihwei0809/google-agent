# ============================================================
# 永豐金證券 Shioaji API 設定範本 (.env.example)
# 複製此檔為 .env 並填入真實金鑰即可啟用正式看盤與下單功能
# 若保持預設或未設定，系統自動啟動「高仿真即時模擬盤」
# ============================================================

# 永豐 API 金鑰 (請至永豐金證券 API 官網申請取得)
SHIOAJI_API_KEY=your_shioaji_api_key_here
SHIOAJI_SECRET_KEY=your_shioaji_secret_key_here

# 帳戶身分證字號 (下單或憑證驗證使用)
SHIOAJI_PERSON_ID=A123456789

# 憑證路徑與密碼 (僅需下單時設定，純看盤免憑證)
SHIOAJI_CA_PATH=C:/path/to/Sinopac.pfx
SHIOAJI_CA_PASS=your_pfx_password

# 運行模式: SIMULATION (免金鑰即時模擬盤) 或 LIVE (正式 Shioaji 實盤連線)
SHIOAJI_MODE=SIMULATION

# 預設自選標的 (逗號分隔代號)
DEFAULT_SYMBOLS=2330,2317,2454,0050,TXF
